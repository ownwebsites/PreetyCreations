{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preetycreations",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".github/**",
      "wrangler.jsonc",
      "wrangler.toml"
    ]
  }
}
